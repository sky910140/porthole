{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "models": {
    "ChangeRequest": {
      "$defs": {
        "FileChange": {
          "additionalProperties": false,
          "properties": {
            "base_sha256": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Base Sha256"
            },
            "content_utf8": {
              "title": "Content Utf8",
              "type": "string"
            },
            "operation": {
              "enum": [
                "create",
                "modify"
              ],
              "title": "Operation",
              "type": "string"
            },
            "path": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Path",
              "type": "string"
            }
          },
          "required": [
            "path",
            "operation",
            "content_utf8"
          ],
          "title": "FileChange",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "project_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "request_id",
        "summary",
        "files"
      ],
      "title": "ChangeRequest",
      "type": "object"
    },
    "ChangeResult": {
      "additionalProperties": false,
      "properties": {
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocked Reason"
        },
        "change_id": {
          "title": "Change Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "manifest_sha256": {
          "title": "Manifest Sha256",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "state": {
          "enum": [
            "pending_review",
            "rejected",
            "expired",
            "conflict",
            "applying",
            "applied",
            "rolled_back",
            "recovery_required",
            "reverting",
            "reverted"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "change_id",
        "state",
        "manifest_sha256",
        "revision"
      ],
      "title": "ChangeResult",
      "type": "object"
    },
    "ErrorDetail": {
      "$defs": {
        "ErrorCode": {
          "enum": [
            "AUTH_REQUIRED",
            "PROJECT_FORBIDDEN",
            "PATH_FORBIDDEN",
            "RATE_LIMITED",
            "SCAN_LIMIT",
            "FILE_TOO_LARGE",
            "FILE_CHANGED",
            "EDITOR_DIRTY",
            "EDITOR_UNAVAILABLE",
            "LEASE_EXPIRED",
            "IDEMPOTENCY_CONFLICT",
            "RECOVERY_REQUIRED",
            "VERSION_INCOMPATIBLE",
            "QUOTA_EXCEEDED",
            "STORAGE_UNAVAILABLE",
            "RECORD_UNAVAILABLE"
          ],
          "title": "ErrorCode",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "FileChange": {
      "additionalProperties": false,
      "properties": {
        "base_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Sha256"
        },
        "content_utf8": {
          "title": "Content Utf8",
          "type": "string"
        },
        "operation": {
          "enum": [
            "create",
            "modify"
          ],
          "title": "Operation",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "operation",
        "content_utf8"
      ],
      "title": "FileChange",
      "type": "object"
    },
    "HealthCheck": {
      "$defs": {
        "ErrorCode": {
          "enum": [
            "AUTH_REQUIRED",
            "PROJECT_FORBIDDEN",
            "PATH_FORBIDDEN",
            "RATE_LIMITED",
            "SCAN_LIMIT",
            "FILE_TOO_LARGE",
            "FILE_CHANGED",
            "EDITOR_DIRTY",
            "EDITOR_UNAVAILABLE",
            "LEASE_EXPIRED",
            "IDEMPOTENCY_CONFLICT",
            "RECOVERY_REQUIRED",
            "VERSION_INCOMPATIBLE",
            "QUOTA_EXCEEDED",
            "STORAGE_UNAVAILABLE",
            "RECORD_UNAVAILABLE"
          ],
          "title": "ErrorCode",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "state": {
          "default": "unknown",
          "enum": [
            "unknown",
            "checking",
            "ok",
            "failed",
            "expired"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "title": "HealthCheck",
      "type": "object"
    },
    "ServiceInfo": {
      "additionalProperties": true,
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "protocol_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Protocol Version",
          "type": "string"
        },
        "service_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Service Version",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "service_version",
        "capabilities"
      ],
      "title": "ServiceInfo",
      "type": "object"
    }
  },
  "protocol_version": "1.0.0"
}
